<div class="search-page">

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="search-page__status">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p class="search-page__status">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
    {% endif %}
  {% endif %}

  {% if search.performed and search.results_count > 0 %}
    <div class="dashboard__feed search-page__feed">
      {% paginate search.results by 20 %}
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            <article class="dashboard__post">
              <div class="dashboard__post-header">
                <h2 class="dashboard__post-title">
                  <a href="{{ result.url }}">{{ result.title }}</a>
                </h2>
                {%- if result.price -%}
                  <span class="dashboard__post-price">
                    {%- render 'sale-price', product: result, compare_class: 'dashboard__post-price-compare', sale_class: 'dashboard__post-price-sale' -%}
                  </span>
                {%- endif -%}
              </div>
              {%- if result.images.size >= 2 -%}
                <div class="dashboard__post-images">
                  <a href="{{ result.url }}" class="dashboard__image-slot">
                    {{ result.images[0] | image_url: width: 600 | image_tag: loading: 'lazy' }}
                  </a>
                  <a href="{{ result.url }}" class="dashboard__image-slot">
                    {{ result.images[1] | image_url: width: 600 | image_tag: loading: 'lazy' }}
                  </a>
                </div>
              {%- else -%}
                <a href="{{ result.url }}" class="dashboard__image-slot dashboard__image-slot--single">
                  {%- if result.featured_image -%}
                    {{ result.featured_image | image_url: width: 740 | image_tag: loading: 'lazy' }}
                  {%- else -%}
                    <div class="dashboard__image-placeholder"></div>
                  {%- endif -%}
                </a>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
        {{ paginate | default_pagination }}
      {% endpaginate %}
    </div>
  {% endif %}

</div>

{% stylesheet %}
  .search-page {
    max-width: 740px;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .search-page__status {
    color: #9aa2ae;
    font-size: 0.82rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .search-page__feed {
    display: flex !important;
    flex-direction: column;
    gap: 1rem;
  }

  .search-page__feed .dashboard__image-slot--single {
    height: 400px;
    max-height: 400px;
  }

  .search-page__feed .dashboard__image-slot--single img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .search-page__feed .dashboard__post-images .dashboard__image-slot {
    height: 500px;
  }

  .search-page__feed .dashboard__post-images .dashboard__image-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
