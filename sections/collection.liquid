<div class="collection-page">

  {% render 'category-nav', active_handle: collection.handle %}

  <!-- Product feed: 2-column grid, same card style as dashboard -->
  <div class="dashboard__feed {% if collection.products.size == 1 %}collection-page__feed--single{% else %}collection-page__feed{% endif %}">
    {% paginate collection.products by 20 %}
      {%- for product in collection.products -%}
        <article class="dashboard__post">
          <div class="dashboard__post-header">
            <h2 class="dashboard__post-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h2>
            {%- if product.price -%}
              <span class="dashboard__post-price">{{ product.price | money }}</span>
            {%- endif -%}
          </div>
          {%- if product.images.size >= 2 -%}
            <div class="dashboard__post-images">
              <a href="{{ product.url }}" class="dashboard__image-slot">
                {{ product.images[0] | image_url: width: 600 | image_tag: loading: 'lazy' }}
              </a>
              <a href="{{ product.url }}" class="dashboard__image-slot">
                {{ product.images[1] | image_url: width: 600 | image_tag: loading: 'lazy' }}
              </a>
            </div>
          {%- else -%}
            <a href="{{ product.url }}" class="dashboard__image-slot dashboard__image-slot--single">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 740 | image_tag: loading: 'lazy' }}
              {%- else -%}
                <div class="dashboard__image-placeholder"></div>
              {%- endif -%}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}

      {{ paginate | default_pagination }}
    {% endpaginate %}
  </div>

</div>

{% stylesheet %}
  .collection-page {
    max-width: 740px;
    margin: 0 auto;
    padding: 1rem 0;
    width: 100%;
    box-sizing: border-box;
  }

  .collection-page__feed {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .collection-page__feed--single {
    display: flex !important;
    flex-direction: column;
    gap: 1rem;
    max-width: 740px;
    margin: 0 auto;
  }

  .collection-page__feed--single .dashboard__image-slot--single {
    height: 500px;
    max-height: 500px;
  }

  .collection-page__feed--single .dashboard__image-slot--single img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .collection-page__feed .dashboard__post-images .dashboard__image-slot {
    height: 280px;
  }

  .collection-page__feed .dashboard__post-images .dashboard__image-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .collection-page__feed .dashboard__image-slot--single {
    height: 280px;
    max-height: 280px;
  }

  .collection-page__feed .dashboard__image-slot--single img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .dashboard__cat-item--active {
    background: #f0f0f0;
    border-radius: 4px;
    margin: 2px;
  }

  .dashboard__cat-item--active span {
    font-weight: 700;
    color: #222;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
