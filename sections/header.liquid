<header class="site-header">
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__right">
    <a href="{{ routes.root_url }}" class="header__home" aria-label="Home">
      <i class="fa-solid fa-house"></i>
    </a>
    <form class="header__search" action="{{ routes.search_url }}" method="get" role="search">
      <i class="fa-solid fa-magnifying-glass header__search-icon"></i>
      <input
        type="search"
        name="q"
        placeholder="{{ 'header.search_placeholder' | t }}"
        aria-label="{{ 'header.search_placeholder' | t }}"
      >
    </form>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
          <i class="fa-solid fa-user"></i>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="{{ 'header.cart' | t }}">
        <i class="fa-solid fa-bag-shopping"></i>
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    background: #2c3a4a;
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    grid-column: 1 / -1;
  }

  .header__title {
    flex-shrink: 0;
  }

  .header__title a {
    font-family: var(--font-title--family);
    font-weight: 700;
    font-size: 1.6rem;
    color: #ffffff;
    text-decoration: none;
    text-transform: lowercase;
    letter-spacing: -0.01em;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header__home {
    color: #9aa2ae;
    font-size: 1.5rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .header__home:hover {
    color: #fff;
  }

  /* Search bar */
  .header__search {
    width: 220px;
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__search-icon {
    position: absolute;
    left: 0.65rem;
    color: #9aa2ae;
    font-size: 0.8rem;
    pointer-events: none;
  }

  .header__search input {
    width: 100%;
    background: #3d4f61;
    border: none;
    border-radius: 4px;
    padding: 0.4rem 0.75rem 0.4rem 2rem;
    color: #ffffff;
    font-size: 0.85rem;
    outline: none;
  }

  .header__search input::placeholder {
    color: #9aa2ae;
  }

  .header__search input:focus {
    background: #4a5f73;
  }

  /* Icons */
  .header__icons {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header__icons a {
    color: #9aa2ae;
    text-decoration: none;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    position: relative;
    transition: color 0.15s;
  }

  .header__icons a:hover {
    color: #ffffff;
  }

  .header__cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #529ECC;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
