        "id": "tumbl_quote_gold",
        "default": "#F2992E",
        "label": "Quote gold"
      },
      {
        "type": "color",
        "id": "tumbl_link_green",
        "default": "#56BC8A",
        "label": "Link green"
      },
      {
        "type": "color",
        "id": "tumbl_chat_blue",
        "default": "#529ECC",
        "label": "Chat blue"
      },
      {
